{
  "expo": {
    "name": "ESK KataLog",
    "slug": "karate-curriculum",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "scheme": "karatecurriculum",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.devmoose14.karatecurriculum",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {},
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./public/icons/icon-192.png"
    },
    "plugins": [
      "expo-router",
      "expo-status-bar",
      "expo-font",
      "expo-video"
    ],
    "extra": {
      "router": {},
      "eas": {
        "projectId": "c7060acb-04b8-4037-b344-2dc9ff48c7fb"
      }
    },
    "icon": "./assets/images/app-icon.png"
  }
}
